    )
    (uuid "4aa4c66f-5232-5400-9ee6-5ef51146d6bc")
  )
  (text "While AC is present Q36 holds Q35 off. Mains off: C41 decays in ~30 ms, Q35 dumps C40, relay opens, chips mute."
    (at 294.64 242.57 0)
    (effects
      (font
        (size 1.27 1.27)
      )
      (justify left bottom)
    )
