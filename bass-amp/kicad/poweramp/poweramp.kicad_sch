  (text "T charges via R40/C40; D40 (12 V) + Darlington Q32/Q33 pull in K1 at ~13.6 V. Anything pulling TD low drops the relay within ~5 ms."
    (at 55.88 186.69 0)
    (effects
      (font
        (size 1.27 1.27)
      )
      (justify left bottom)
    )
    (uuid "7dd0ee64-8124-5572-b9b5-3a891d187010")
