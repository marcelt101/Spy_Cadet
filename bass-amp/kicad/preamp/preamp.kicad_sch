  (text "Power input and decoupling"
    (at 55.88 57.15 0)
    (effects
      (font
        (size 2 2)
        bold
      )
      (justify left bottom)
    )
    (uuid "fdc48862-22cc-5611-ba52-109b1fca8b3c")
  )
  (text "J1: +/-15 V from PSU (3-pin). J2: +/-40 V from PSU (4-pin, different size so they cannot be swapped)."
    (at 55.88 181.61 0)
    (effects
      (font
        (size 1.27 1.27)
      )
      (justify left bottom)
    )
    (uuid "04b32738-58b8-5bb7-a9b0-630a69d0cf3e")
  )
  (text "A1: bootstrapped instrument input / gain (+1.7 .. +27 dB)"
    (at 294.64 57.15 0)
    (effects
      (font
        (size 2 2)
        bold
      )
      (justify left bottom)
    )
    (uuid "26c22b76-2aa1-5a17-8995-9775999b7807")
  )
  (text "RA (R2) bootstrapped by C3 from INN: >1 MOhm input. VR1 rheostat, gain rises CW. C2/C3: film, 100 V."
    (at 294.64 153.67 0)
    (effects
      (font
        (size 1.27 1.27)
      )
      (justify left bottom)
    )
    (uuid "dee72cc2-e9a8-5cfb-92ed-bf7de79ae887")
  )
  (text "EQ: Baxandall bass / treble (U1A)"
    (at 533.4 57.15 0)
    (effects
      (font
        (size 2 2)
        bold
      )
      (justify left bottom)
    )
    (uuid "e903c2ba-5229-5865-8e00-f4079d11825c")
  )
  (text "CW = boost (wiper toward the input-side end)."
    (at 533.4 125.73 0)
    (effects
      (font
        (size 1.27 1.27)
      )
      (justify left bottom)
    )
    (uuid "5bdb15ea-3f22-5a75-b709-d3944702d363")
  )
  (text "EQ: mid, gyrator with 5-way frequency switch (U1B, U2A)"
    (at 533.4 146.05 0)
    (effects
      (font
        (size 2 2)
        bold
      )
      (justify left bottom)
    )
    (uuid "5e0c62c2-b408-5dcf-a6f0-11d849f10984")
  )
  (text "J9 to a 2-pole rotary (pole A: MW -> Cs1..5, pole B: GP -> Cg1..5). 250/500/800/1.5k/3k Hz. Short shielded wiring."
    (at 533.4 242.57 0)
    (effects
      (font
        (size 1.27 1.27)
      )
      (justify left bottom)
    )
    (uuid "173b1168-4aea-50f3-be34-a6bc6f60c975")
  )
  (text "FX send (U2B) and FX return (A2, HV unity buffer)"
    (at 294.64 173.99 0)
    (effects
      (font
        (size 2 2)
        bold
      )
      (justify left bottom)
    )
    (uuid "f8595764-db42-5db5-9481-b999c251979d")
  )
  (text "J5 is a switched jack: its switch lug (pin 2) carries EQ_OUT, so the loop is closed when nothing is plugged in."
    (at 294.64 298.45 0)
    (effects
      (font
        (size 1.27 1.27)
      )
      (justify left bottom)
    )
    (uuid "9d1cd334-2362-5ac2-aa55-be019ae1b4a5")
  )
  (text "Master, aux in (U3A), subsonic filter (U6A), bridge phase splitter (U3B)"
    (at 55.88 201.93 0)
    (effects
      (font
        (size 2 2)
        bold
      )
      (justify left bottom)
    )
    (uuid "dca2ae2b-3f7a-5e26-ab5a-628e0ec10076")
  )
  (text "J11 to a DPDT: closing both poles = TIGHT (~40 Hz); open = DEEP (22 Hz). J15 to the power amp board."
    (at 55.88 354.33 0)
    (effects
      (font
        (size 1.27 1.27)
      )
      (justify left bottom)
    )
    (uuid "26ca0bc7-ecfa-5146-b871-6305fb629fd9")
  )
  (text "Headphone amplifier (U4)"
    (at 533.4 262.89 0)
    (effects
      (font
        (size 2 2)
        bold
      )
      (justify left bottom)
    )
    (uuid "52b67a25-d085-5b7c-95cd-9ecdd148a4b5")
  )
  (text "Phones jack switch contacts are wired to the power amp board (J5 there) to mute the speaker."
    (at 533.4 303.53 0)
    (effects
      (font
        (size 1.27 1.27)
      )
      (justify left bottom)
    )
    (uuid "21c4da44-2c6e-5250-91ab-bd04d447ccb1")
  )
  (text "Balanced DI / line out (U5)"
    (at 294.64 318.77 0)
    (effects
      (font
        (size 2 2)
        bold
      )
      (justify left bottom)
    )
    (uuid "2139a7d1-20f3-516f-bd2f-002b481f160f")
  )
  (text "J12: PRE/POST select. J13: closing it = -20 dB pad. J14: ground-lift switch. C81/C82 + toward the XLR (phantom)."
    (at 294.64 471.17 0)
    (effects
      (font
        (size 1.27 1.27)
      )
      (justify left bottom)
    )
    (uuid "21be4623-57d5-5509-aee9-c4a9446fbf1a")
  )
  (text "PRE clip indicator"
    (at 533.4 323.85 0)
    (effects
      (font
        (size 2 2)
        bold
      )
      (justify left bottom)
    )
    (uuid "78c513fe-f9c3-5a41-9be9-6dc59a9a186f")
  )
  (text "Lights at about +/-11.3 V peak (2.5 dB before the NE5532 stages clip). J16 to a panel LED."
    (at 533.4 392.43 0)
    (effects
      (font
        (size 1.27 1.27)
      )
      (justify left bottom)
    )
    (uuid "7af56512-255a-5105-a723-08d957912d36")
  )
