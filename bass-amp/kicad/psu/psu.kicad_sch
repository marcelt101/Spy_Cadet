  (paper "A2")
  (title_block
    (title "Bass amp PSU board: +/-28 V, +/-40 V (discrete reg), +/-15 V (discrete reg)")
    (rev "1")
    (comment 1 "Mains wiring (IEC inlet, fuse T3.15A/230V or T6.3A/115V, switch, 5 R NTC) is chassis-wired, not on this board.")
    (comment 2 "T1: 400 VA toroid 2 x 20 VAC. T2: 15-30 VA 2 x 40 VAC. Centre taps to GND; star point = C1-C4 junction.")
    (comment 3 "BR1: GBJ2506 25 A - check the footprint pitch against your part; small heatsink.")
    (comment 4 "Q12/Q15 (MJE340/MJE350) and Q2/Q5 (BD139/BD140) need small clip-on heatsinks.")
  )
