  (paper "A2")
  (title_block
    (title "HVOA-1 +/-40 V nested-cascode discrete op-amp module")
    (rev "1")
    (comment 1 "Build twice: A1 (instrument input) and A2 (FX return). Parts marked \"A1 / A2\" differ.")
